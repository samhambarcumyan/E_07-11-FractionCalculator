        <Button Name="btnClear" Content="celar" HorizontalAlignment="Left"   Margin="112,279,0,0" VerticalAlignment="Top" Width="70" Height="45" Click="btnClear_Click"/>
        <Button Name="btnCalculate" Content="calculate" HorizontalAlignment="Left" Margin="280,279,0,0" VerticalAlignment="Top" Height="45" Width="70" Click="btnCalculate_Click"/>
        <Label Content="=" HorizontalAlignment="Left" Margin="366,163,0,0" VerticalAlignment="Top"/>
        <Label Content="" Name="MessageLbl" HorizontalAlignment="Left" Margin="472,156,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.144,0.419"/>

    </Grid>
