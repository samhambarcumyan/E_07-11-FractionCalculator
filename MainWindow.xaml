        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox Name="num1" HorizontalAlignment="Left" Margin="112,116,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="60" RenderTransformOrigin="-0.23,0.516" Height="40"/>
        <TextBox Name="den1" HorizontalAlignment="Left" Margin="112,190,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="60" RenderTransformOrigin="-0.23,0.516" Height="37"/>
        <TextBox Name="num2" HorizontalAlignment="Left" Margin="290,116,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="60" RenderTransformOrigin="-0.23,0.516" Height="40"/>
        <TextBox Name="den2" HorizontalAlignment="Left" Margin="290,190,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="60" RenderTransformOrigin="-0.23,0.516" Height="37"/>
        <Label Content="AnsNum" Name="lblAnsNum" HorizontalAlignment="Left" Margin="400,130,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.702,-1.014"/>
        <Label Content="AnsDen" Name="lblAnsDen" HorizontalAlignment="Left" Margin="400,191,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.702,-1.014"/>
